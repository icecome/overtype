{
  "name": "overtypeplus-editor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "verify:markdown": "node --experimental-strip-types scripts/verify-markdown.mjs",
    "verify:preview-styles": "node --experimental-strip-types scripts/verify-preview-styles.mts",
    "demo:preview": "node --experimental-strip-types scripts/generate-preview-demo.mjs"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  },
  "dependencies": {
    "marked": "^15.0.12",
    "overtypeplus": "^2.4.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zustand": "^5.0.15"
  }
}
